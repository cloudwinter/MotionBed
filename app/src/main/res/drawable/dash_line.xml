<?xml version="1.0" encoding="utf-8"?>
<rotate xmlns:android="http://schemas.android.com/apk/res/android"
    android:fromDegrees="90"
    android:toDegrees="90"
    android:left="-600dp"
    android:right="-600dp">
    <shape android:shape="line">
        <stroke
            android:width="1dp"
            android:color="#FFF"
            android:dashWidth="3dp"
            android:dashGap="1dp" />
    </shape>
</rotate>