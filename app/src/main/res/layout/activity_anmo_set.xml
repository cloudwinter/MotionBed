<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/ic_bg"
    android:orientation="vertical"
    tools:context=".activity.AnmoSetActivity">

    <com.sn.blackdianqi.view.TranslucentActionBar
        android:id="@+id/actionbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_15"
                android:background="@drawable/bg_rectangle_gray"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/dp_10"
                android:paddingVertical="@dimen/dp_6">

                <ImageView
                    android:layout_width="@dimen/dp_28"
                    android:layout_height="@dimen/dp_28"
                    android:src="@mipmap/weitiao_icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_10"
                    android:text="@string/moshi_xuanze"
                    android:textColor="@color/color_C9C9C9"
                    android:textSize="@dimen/sp_14" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_10"
                android:layout_marginTop="@dimen/dp_15"
                android:orientation="horizontal">

                <com.sn.blackdianqi.view.AnjianTextView
                    android:id="@+id/view_quanshen"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_50"
                    android:layout_marginHorizontal="@dimen/dp_5"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:textColor="@color/white"
                    app:bgnormal="@drawable/bg_tuoyuan_normal"
                    app:bgselected="@drawable/bg_tuoyuan_selected"
                    app:size="@dimen/sp_11"
                    app:title="@string/zuheanmo" />

                <com.sn.blackdianqi.view.AnjianTextView
                    android:id="@+id/view_beibu"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="@dimen/dp_5"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:textColor="@color/white"
                    app:bgnormal="@drawable/bg_tuoyuan_normal"
                    app:bgselected="@drawable/bg_tuoyuan_selected"
                    app:size="@dimen/sp_11"
                    app:title="@string/bolanganmo" />

                <com.sn.blackdianqi.view.AnjianTextView
                    android:id="@+id/view_yaobu"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="@dimen/dp_5"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:textColor="@color/white"
                    app:bgnormal="@drawable/bg_tuoyuan_normal"
                    app:bgselected="@drawable/bg_tuoyuan_selected"
                    app:size="@dimen/sp_11"
                    app:title="@string/yaobuanmo" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_10"
                android:layout_marginTop="@dimen/dp_15"
                android:orientation="horizontal">

                <com.sn.blackdianqi.view.AnjianTextView
                    android:id="@+id/view_jingbu"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_50"
                    android:layout_marginHorizontal="@dimen/dp_5"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:textColor="@color/white"
                    app:bgnormal="@drawable/bg_tuoyuan_normal"
                    app:bgselected="@drawable/bg_tuoyuan_selected"
                    app:size="@dimen/sp_11"
                    app:title="@string/jingbuanmo" />

                <com.sn.blackdianqi.view.AnjianTextView
                    android:id="@+id/view_yujia"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="@dimen/dp_5"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:textColor="@color/white"
                    app:bgnormal="@drawable/bg_tuoyuan_normal"
                    app:bgselected="@drawable/bg_tuoyuan_selected"
                    app:size="@dimen/sp_11"
                    app:title="@string/yujia2" />

                <com.sn.blackdianqi.view.AnjianTextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="@dimen/dp_5"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_12" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_15"
                android:layout_marginTop="@dimen/dp_20"
                android:background="@drawable/bg_rectangle_gray"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/dp_10"
                android:paddingVertical="@dimen/dp_6">

                <ImageView
                    android:layout_width="@dimen/dp_28"
                    android:layout_height="@dimen/dp_28"
                    android:src="@mipmap/anmo_qiangdu" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_10"
                    android:text="@string/anmo_qiangdu"
                    android:textColor="@color/color_C9C9C9"
                    android:textSize="@dimen/sp_14" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_15"
                android:gravity="center"
                android:orientation="vertical">


                <ImageView
                    android:layout_width="@dimen/dp_120"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/quxian" />

                <LinearLayout
                    android:layout_width="@dimen/dp_200"
                    android:layout_height="@dimen/dp_50"
                    android:background="@drawable/bg_tuoyuan_normal"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/ll_minus"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="@dimen/dp_50"
                            android:layout_height="@dimen/dp_50"
                            android:padding="@dimen/dp_15"
                            android:scaleType="fitCenter"
                            android:src="@drawable/bg_minus_selector" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_plus"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text=""
                        android:textColor="@color/white"
                        android:textSize="@dimen/sp_14" />


                    <LinearLayout
                        android:id="@+id/ll_plus"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="@dimen/dp_50"
                            android:layout_height="@dimen/dp_50"
                            android:padding="@dimen/dp_15"
                            android:scaleType="fitCenter"
                            android:src="@drawable/bg_plus_selector" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_15"
                android:layout_marginTop="@dimen/dp_20"
                android:background="@drawable/bg_rectangle_gray"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/dp_10"
                android:paddingVertical="@dimen/dp_6">

                <ImageView
                    android:layout_width="@dimen/dp_28"
                    android:layout_height="@dimen/dp_28"
                    android:src="@mipmap/clock" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_10"
                    android:text="@string/anmo_time"
                    android:textColor="@color/color_C9C9C9"
                    android:textSize="@dimen/sp_14" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="15dp"
                android:orientation="horizontal">


                <com.sn.blackdianqi.view.AnjianAnmoYuanView
                    android:id="@+id/view_10time"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:bgnormal="@drawable/bg_tuoyuan_normal"
                    app:bgselected="@drawable/bg_tuoyuan_selected"
                    app:icon="@mipmap/ic_time_10_normal"
                    app:imgnormal="@mipmap/ic_time_10_normal"
                    app:imgselected="@mipmap/ic_time_10_selected"
                    app:title="@string/tenmin" />

                <View
                    android:layout_width="25dp"
                    android:layout_height="match_parent" />

                <com.sn.blackdianqi.view.AnjianAnmoYuanView
                    android:id="@+id/view_20time"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:bgnormal="@drawable/bg_tuoyuan_normal"
                    app:bgselected="@drawable/bg_tuoyuan_selected"
                    app:icon="@mipmap/ic_time_20_normal"
                    app:imgnormal="@mipmap/ic_time_20_normal"
                    app:imgselected="@mipmap/ic_time_20_selected"
                    app:title="@string/twentymin" />

                <View
                    android:layout_width="25dp"
                    android:layout_height="match_parent" />

                <com.sn.blackdianqi.view.AnjianAnmoYuanView
                    android:id="@+id/view_30time"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:bgnormal="@drawable/bg_tuoyuan_normal"
                    app:bgselected="@drawable/bg_tuoyuan_selected"
                    app:icon="@mipmap/ic_time_30_normal"
                    app:imgnormal="@mipmap/ic_time_30_normal"
                    app:imgselected="@mipmap/ic_time_30_selected"
                    app:title="@string/thirtymin" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/tvConfirm"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_45"
        android:layout_marginHorizontal="@dimen/dp_15"
        android:layout_marginVertical="@dimen/dp_15"
        android:background="@drawable/shape_btn_green"
        android:gravity="center"
        android:text="@string/dialog_confirm"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_14" />

</LinearLayout>