<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:background="@drawable/bg_tuoyuan_normal"
    android:orientation="vertical">


    <LinearLayout
        android:id="@+id/layout_sanjiao_top"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center">

        <ImageView
            android:id="@+id/img_sanjiao_top"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/bg_sanjiao_top_selector" />

    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">


        <ImageView
            android:id="@+id/img_xr"
            android:layout_width="50dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="@mipmap/xr_kandianshi_xiao" />

        <TextView
            android:id="@+id/text_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:textColor="@color/text_white"
            android:textSize="@dimen/anjian_tuoyuan_title_size" />
    </LinearLayout>


    <LinearLayout
        android:id="@+id/layout_sanjiao_bottom"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center">

        <ImageView
            android:id="@+id/img_sanjiao_bottom"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/bg_sanjiao_bottom_selector" />

    </LinearLayout>

</LinearLayout>