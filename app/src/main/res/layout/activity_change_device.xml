<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/ic_bg"
    android:orientation="vertical"
    tools:context=".activity.ChangeDeviceActivity">

    <com.sn.blackdianqi.view.TranslucentActionBar
        android:id="@+id/actionbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:id="@+id/llDianDong"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="@dimen/dp_15"
        android:layout_marginTop="30dp"
        android:layout_marginRight="@dimen/dp_15"
        android:background="@drawable/bg_blue_item"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/diandongchuang"
            android:textColor="@color/text_white"
            android:textSize="14dp" />

        <TextView
            android:id="@+id/tvDisconnectDianDong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:text="@string/duankai_device"
            android:textColor="@color/text_green"
            android:textSize="14dp" />

        <ImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@mipmap/ic_row" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llQiNang"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="@dimen/dp_15"
        android:layout_marginTop="20dp"
        android:layout_marginRight="@dimen/dp_15"
        android:background="@drawable/bg_blue_item"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/qinangchuangdian"
            android:textColor="@color/text_white"
            android:textSize="14dp" />

        <TextView
            android:id="@+id/tvDisconnectQiNang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:text="@string/duankai_device"
            android:textColor="@color/text_green"
            android:textSize="14dp" />

        <ImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@mipmap/ic_row" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llLengNuan"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="@dimen/dp_15"
        android:layout_marginTop="20dp"
        android:layout_marginRight="@dimen/dp_15"
        android:background="@drawable/bg_blue_item"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/lengnuanchuangdian"
            android:textColor="@color/text_white"
            android:textSize="14dp" />

        <TextView
            android:id="@+id/tvDisconnectLengNuan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:text="@string/duankai_device"
            android:textColor="@color/text_green"
            android:textSize="14dp" />

        <ImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@mipmap/ic_row" />
    </LinearLayout>

</LinearLayout>